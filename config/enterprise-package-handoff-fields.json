      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "EISCore 内部产品标题、主题色与系统 Logo，不承载公开企业介绍。"
    },
    {
      "fieldId": "runtime.endpoints",
      "operatorPath": "deployment.endpoints",
      "targetFile": "runtime/eiscore-enterprise.json",
      "targetPaths": ["$.endpoints.agentBasePath", "$.endpoints.apiBasePath", "$.endpoints.publicBaseUrl", "$.endpoints.realtimeWsPath"],
      "scope": "internal",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "deployment",
      "description": "每套隔离环境的公开根地址和 API/Agent/WebSocket 路径；不包含凭据。"
    },
    {
      "fieldId": "runtime.enterprise",
      "operatorPath": "deployment.enterpriseIdentity",
      "targetFile": "runtime/eiscore-enterprise.json",
      "targetPaths": ["$.enterprise.displayName", "$.enterprise.id", "$.enterprise.shortName"],
      "scope": "internal",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "部署内稳定企业 ID 和内部显示名；跟踪 ID 不是自动批准的运行值。"
    },
    {
      "fieldId": "runtime.features",
      "operatorPath": "deployment.features",
      "targetFile": "runtime/eiscore-enterprise.json",
      "targetPaths": ["$.features"],
      "scope": "internal",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "模块内功能开关，须与模块依赖和实际验收范围一致。"
    },
    {
      "fieldId": "runtime.modules",
      "operatorPath": "deployment.modules",
      "targetFile": "runtime/eiscore-enterprise.json",
      "targetPaths": ["$.modules"],
      "scope": "internal",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "11 个部署模块的显式开关；需求候选不能直接解释为已启用范围。"
    },
    {
      "fieldId": "site.contact",
      "operatorPath": "companySite.identity.contact",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.contact"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "允许公开的联系方式和询盘渠道；私人联系方式不进入一般工程文件。"
    },
    {
      "fieldId": "site.domain",
      "operatorPath": "companySite.identity.domain",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.domain"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "deployment",
      "description": "正式公开域名及控制权确认；历史或候选域名不能直接进入批准包。"
    },
    {
      "fieldId": "site.identity",
      "operatorPath": "companySite.identity.names",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.brandName", "$.site.brandShortName", "$.site.factoryName", "$.site.legalName"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "公开法律主体、品牌和工厂名称；合同内部字段不能自动公开。"
    },
    {
      "fieldId": "site.locales",
      "operatorPath": "companySite.localization",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.defaultLocale", "$.site.enabledLocales"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "目标市场语言、默认语言和翻译责任范围。"
    },
    {
      "fieldId": "site.seo",
      "operatorPath": "companySite.identity.seo",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.seo"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "站点级标题、描述和关键词草稿。"
    },
    {
      "fieldId": "site.settings",
      "operatorPath": "companySite.settings",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.settings"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "implementation",
      "description": "公开站点行为配置；不能包含密钥、数据库连接或发布捷径。"
    },
    {
      "fieldId": "site.socialLinks",
      "operatorPath": "companySite.identity.socialLinks",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.socialLinks"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "企业确认拥有的公开社交或渠道链接。"
    },
    {
      "fieldId": "site.template",
      "operatorPath": "companySite.presentation.template",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.templateKey"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "implementation",
      "description": "核心制品支持的站点模板选择，不产生客户专属源码。"
    },
    {
      "fieldId": "site.theme",
      "operatorPath": "companySite.presentation.theme",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.theme"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "公开站点主题变量，与内部系统主题分开确认。"
    },
    {
      "fieldId": "site.trademark",
      "operatorPath": "companySite.identity.trademark",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.site.trademark.faviconAssetPath", "$.site.trademark.logoAssetPath", "$.site.trademark.name", "$.site.trademark.registrationNumber"],
