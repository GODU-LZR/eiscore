{
  "$schema": "./enterprise-package-handoff.schema.json",
  "documentType": "enterprise-package-handoff-field-catalog",
  "schemaVersion": 1,
  "mappingVersion": 1,
  "fields": [
    {
      "fieldId": "acceptance.businessFlows",
      "operatorPath": "acceptance.businessFlows",
      "targetFile": "evidence/handoff.json",
      "targetPaths": ["$.acceptance.businessFlows"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "至少一条上线必需业务链及其受控验收样本；不进入公开站点内容。"
    },
    {
      "fieldId": "acceptance.rolesAndPermissions",
      "operatorPath": "acceptance.rolesAndPermissions",
      "targetFile": "evidence/handoff.json",
      "targetPaths": ["$.acceptance.rolesAndPermissions"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "角色、权限和账号来源确认；只保存非秘密、非个人凭据的交付证据。"
    },
    {
      "fieldId": "content.cases",
      "operatorPath": "companySite.content.cases",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.cases"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "经授权公开的案例草稿；客户名称、合同和交付数据默认不公开。"
    },
    {
      "fieldId": "content.certificates",
      "operatorPath": "companySite.content.certificates",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.certificates"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "证书与认证草稿；必须确认主体、有效期和公开授权。"
    },
    {
      "fieldId": "content.downloads",
      "operatorPath": "companySite.content.downloads",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.downloads"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "公开下载资料草稿及其素材引用。"
    },
    {
      "fieldId": "content.evidence",
      "operatorPath": "companySite.content.evidence",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.evidence"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "implementation",
      "description": "支持公开主张的非敏感证据索引；原始敏感资料保留在受控来源系统。"
    },
    {
      "fieldId": "content.externalProfiles",
      "operatorPath": "companySite.content.externalProfiles",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.externalProfiles"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "企业确认拥有或控制的外部公开档案。"
    },
    {
      "fieldId": "content.keywords",
      "operatorPath": "companySite.content.keywords",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.keywords"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "独立站关键词草稿，不能把研究词直接解释为企业事实。"
    },
    {
      "fieldId": "content.knowledge",
      "operatorPath": "companySite.content.knowledge",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.knowledge"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "FAQ、公开知识和禁用主张，全部作为草稿导入。"
    },
    {
      "fieldId": "content.pages",
      "operatorPath": "companySite.content.pages",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.pages"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "页面结构和公开文案草稿。"
    },
    {
      "fieldId": "content.productLocales",
      "operatorPath": "companySite.content.productLocales",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.productLocales"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "产品多语言名称、描述、图片和 FAQ 草稿。"
    },
    {
      "fieldId": "content.products",
      "operatorPath": "companySite.content.products",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.products"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "企业确认可公开的产品范围；SKU、规格、价格、MOQ、库存和交期分别确认。"
    },
    {
      "fieldId": "content.seo",
      "operatorPath": "companySite.content.seoRecords",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.seo"],
      "scope": "public",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "逐路径 SEO/GEO 草稿及结构化数据。"
    },
    {
      "fieldId": "content.solutions",
      "operatorPath": "companySite.content.solutions",
      "targetFile": "data/company-site.json",
      "targetPaths": ["$.content.solutions"],
      "scope": "public",
      "requirement": "conditional",
      "productionRule": "confirmed-or-not-applicable",
      "confirmationOwner": "enterprise",
      "description": "经企业确认的场景与解决方案草稿。"
    },
    {
      "fieldId": "governance.assetStatus",
      "operatorPath": "governance.assets.status",
      "targetFile": "manifest.json",
      "targetPaths": ["$.governance.assetStatus"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "authorized",
      "confirmationOwner": "implementation",
      "description": "由素材清单、完整性与书面商用授权共同推导，不能人工跳过。"
    },
    {
      "fieldId": "governance.factStatus",
      "operatorPath": "governance.facts.status",
      "targetFile": "manifest.json",
      "targetPaths": ["$.governance.confirmedAt", "$.governance.confirmedBy", "$.governance.factStatus"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "implementation",
      "description": "只在必需事实逐项获得权威确认后汇总为 confirmed。"
    },
    {
      "fieldId": "governance.productionApproval",
      "operatorPath": "governance.package.productionApproval",
      "targetFile": "manifest.json",
      "targetPaths": ["$.governance.productionApproved", "$.status"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "explicit-approval",
      "confirmationOwner": "implementation",
      "description": "生产批准是独立显式决策；候选资料、通过校验或存在旧发布记录均不能替代。"
    },
    {
      "fieldId": "migration.scope",
      "operatorPath": "migration.scope",
      "targetFile": "evidence/handoff.json",
      "targetPaths": ["$.migration.exclusions", "$.migration.inclusions", "$.migration.transformationRules"],
      "scope": "delivery-governance",
      "requirement": "required",
      "productionRule": "confirmed",
      "confirmationOwner": "enterprise",
      "description": "旧数据、内容与素材的纳入/排除范围及清洗规则；旧 published 状态必须转换为 draft。"
    },
