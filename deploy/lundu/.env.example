POSTGRES_PASSWORD=
POSTGREST_DB_PASSWORD=
AGENT_DB_PASSWORD=
FLASH_AGENT_DB_USER=eiscore_flash_agent
FLASH_AGENT_DB_PASSWORD=
PGRST_JWT_SECRET=
EISCORE_PUBLIC_BASE_URL=https://lundu.eiscore.top
EISCORE_HARNESS_ENABLED=true
EISCORE_HARNESS_URL=http://harness-bridge:3080
EISCORE_HARNESS_AUDIT_FILE=/var/lib/eiscore/harness-audit.jsonl
EISCORE_HARNESS_AUDIT_HASH_KEY=replace_me_with_a_random_harness_audit_key
EISCORE_HARNESS_BRIDGE_SECRET=replace_me_with_a_random_harness_bridge_secret
EISCORE_TOOL_PROXY_SECRET=replace_me_with_a_random_tool_proxy_secret
FLASH_EISCORE_HARNESS_URL=http://flash-harness-bridge:3080
FLASH_EISCORE_HARNESS_AUDIT_FILE=/var/lib/eiscore/flash-harness-audit.jsonl
FLASH_EISCORE_HARNESS_AUDIT_HASH_KEY=replace_me_with_a_random_flash_harness_audit_key
FLASH_EISCORE_HARNESS_BRIDGE_SECRET=replace_me_with_a_random_flash_harness_bridge_secret
FLASH_EISCORE_TOOL_PROXY_SECRET=replace_me_with_a_random_flash_tool_proxy_secret
FLASH_DEEPSEEK_API_KEY=replace_me_with_a_distinct_flash_deepseek_api_key
