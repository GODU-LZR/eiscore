# Copy this file to env/.env, replace every replace_me value, then run:
# node scripts/validate-production-env.mjs --env-file env/.env

# Required production values. Generate independent secrets with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=replace_me_with_a_random_base64url_secret
PGRST_JWT_SECRET=replace_me_with_an_independent_random_base64url_secret
POSTGREST_DB_PASSWORD=replace_me_with_a_distinct_postgrest_role_secret
AGENT_DB_PASSWORD=replace_me_with_a_distinct_agent_role_secret

# Public origin only: HTTPS, no path, query, fragment, credentials, or trailing slash.
EISCORE_PUBLIC_BASE_URL=https://erp.example.com

# DeepSeek Harness bridge and audit contract.
EISCORE_HARNESS_ENABLED=true
EISCORE_HARNESS_URL=http://harness-bridge:3080
EISCORE_HARNESS_AUDIT_FILE=/var/lib/eiscore/harness-audit.jsonl
EISCORE_HARNESS_AUDIT_HASH_KEY=replace_me_with_a_random_harness_audit_key
EISCORE_HARNESS_BRIDGE_SECRET=replace_me_with_a_random_harness_bridge_secret
EISCORE_TOOL_PROXY_SECRET=replace_me_with_a_random_tool_proxy_secret
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
BRIDGE_STATE_FILE=/var/lib/dsh/bridge-state.json
BRIDGE_MAX_BODY_BYTES=2097152
BRIDGE_MAX_RESPONSE_BYTES=2097152
BRIDGE_PROMPT_TIMEOUT_MS=120000
BRIDGE_SESSION_DRAIN_TIMEOUT_MS=120000
BRIDGE_RPC_TIMEOUT_MS=120000
BRIDGE_SHUTDOWN_TIMEOUT_MS=1000

# Runtime defaults may be overridden per deployment when required.
TZ=Asia/Shanghai
FLASH_PROJECT_PATH=eiscore-apps/src/views/drafts
FLASH_WORKDIR=/workspace/eiscore-apps/src/views/drafts
